{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/windows-support-diagnostic-toolkit/cleanup-record.schema.json",
  "title": "Guided Cleanup Result Record",
  "description": "Version 1.0.0 contract for ignored, machine-local Recycle Bin operation results.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "operation_id",
    "started_at_utc",
    "completed_at_utc",
    "source_report",
    "requested_count",
    "requested_unique_bytes",
    "summary",
    "results",
    "safety"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "guided_cleanup_result"},
    "operation_id": {"type": "string", "format": "uuid"},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "completed_at_utc": {"type": "string", "format": "date-time"},
    "source_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_at_utc", "drive_letter"],
      "properties": {
        "generated_at_utc": {"type": "string", "format": "date-time"},
        "drive_letter": {"type": "string", "pattern": "^[A-Z]:$"}
      }
    },
    "requested_count": {"type": "integer", "minimum": 1, "maximum": 500},
    "requested_unique_bytes": {"type": "integer", "minimum": 0},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recycled", "skipped_changed", "skipped_protected_or_invalid", "missing", "failed"],
      "properties": {
        "recycled": {"type": "integer", "minimum": 0},
        "skipped_changed": {"type": "integer", "minimum": 0},
        "skipped_protected_or_invalid": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0}
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "path", "expected_size_bytes", "expected_modified_at_utc", "status", "message"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1, "maxLength": 100},
          "item_type": {"enum": ["file", "folder"]},
          "path": {"type": "string", "minLength": 3, "maxLength": 32767},
          "expected_size_bytes": {"type": ["integer", "null"], "minimum": 0},
          "expected_modified_at_utc": {"type": ["string", "null"], "format": "date-time"},
          "status": {"enum": ["recycled", "skipped_changed", "skipped_protected_or_invalid", "missing", "failed"]},
          "message": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "permanent_delete_fallback", "directories_allowed"],
      "properties": {
        "action": {"const": "windows_recycle_bin_only"},
        "permanent_delete_fallback": {"const": false},
        "directories_allowed": {"type": "boolean"}
      }
    }
  }
}
