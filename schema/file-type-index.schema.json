{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/windows-support-diagnostic-toolkit/file-type-index.schema.json",
  "title": "File-Type Explorer Index",
  "description": "Version 1.0.0 contract for one local, metadata-only, per-drive file-type index.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "index_type",
    "index_id",
    "generated_at_utc",
    "indexer",
    "drive",
    "scan",
    "scope",
    "extension_groups",
    "custom_extensions",
    "folders",
    "empty_summary",
    "file_detail_summary",
    "files",
    "inaccessible_paths",
    "scan_errors",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "index_type": {
      "const": "file_type_index"
    },
    "index_id": {
      "$ref": "#/$defs/localId"
    },
    "generated_at_utc": {
      "$ref": "#/$defs/utcDateTime"
    },
    "indexer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "platform", "mode"],
      "properties": {
        "name": {
          "const": "File-Type Explorer Indexer"
        },
        "version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "platform": {
          "const": "Windows"
        },
        "mode": {
          "const": "metadata_only"
        }
      }
    },
    "drive": {
      "$ref": "#/$defs/drive"
    },
    "scan": {
      "$ref": "#/$defs/scan"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "extension_groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/extensionGroup"
      }
    },
    "custom_extensions": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/extension"
      }
    },
    "folders": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000000,
      "items": {
        "$ref": "#/$defs/folder"
      }
    },
    "empty_summary": {
      "$ref": "#/$defs/emptySummary"
    },
    "file_detail_summary": {
      "$ref": "#/$defs/fileDetailSummary"
    },
    "files": {
      "type": "array",
      "maxItems": 1000000,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "inaccessible_paths": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/inaccessiblePath"
      }
    },
    "scan_errors": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/scanError"
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "utcDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "localId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "path": {
      "type": "string",
      "minLength": 3,
      "maxLength": 32767
    },
    "extension": {
      "type": "string",
      "minLength": 2,
      "maxLength": 255,
      "pattern": "^\\.[^\\\\/:*?\"<>|]+$"
    },
    "drive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drive_letter",
        "volume_label",
        "filesystem",
        "total_bytes",
        "used_bytes",
        "free_bytes",
        "observed_at_utc"
      ],
      "properties": {
        "drive_letter": {
          "type": "string",
          "pattern": "^[A-Z]:$"
        },
        "volume_label": {
          "type": ["string", "null"],
          "maxLength": 255
        },
        "filesystem": {
          "type": ["string", "null"],
          "maxLength": 50
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "used_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "free_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "observed_at_utc": {
          "$ref": "#/$defs/utcDateTime"
        }
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at_utc",
        "completed_at_utc",
        "duration_ms",
        "status",
        "aggregate_coverage",
        "files_examined",
        "directories_examined",
        "logical_bytes_observed",
        "zero_byte_files",
        "matching_files",
        "matching_logical_bytes",
        "inaccessible_path_details_retained",
        "inaccessible_path_details_omitted",
        "scan_error_details_retained",
        "scan_error_details_omitted"
      ],
      "properties": {
        "started_at_utc": {
          "$ref": "#/$defs/utcDateTime"
        },
        "completed_at_utc": {
          "$ref": "#/$defs/utcDateTime"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": ["complete", "partial", "cancelled", "failed"]
        },
        "aggregate_coverage": {
          "enum": ["exact", "partial", "unavailable"]
        },
        "files_examined": {
          "type": "integer",
          "minimum": 0
        },
        "directories_examined": {
          "type": "integer",
          "minimum": 0
        },
        "logical_bytes_observed": {
          "type": "integer",
          "minimum": 0
        },
        "zero_byte_files": {
          "type": "integer",
          "minimum": 0
        },
        "matching_files": {
          "type": "integer",
          "minimum": 0
        },
        "matching_logical_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "inaccessible_path_details_retained": {
          "type": "integer",
          "minimum": 0
        },
        "inaccessible_path_details_omitted": {
          "type": "integer",
          "minimum": 0
        },
        "scan_error_details_retained": {
          "type": "integer",
          "minimum": 0
        },
        "scan_error_details_omitted": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_path", "recursive", "explicitly_requested"],
      "properties": {
        "root_path": {
          "$ref": "#/$defs/path"
        },
        "recursive": {
          "const": true
        },
        "explicitly_requested": {
          "const": true
        }
      }
    },
    "extensionGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_id", "label", "extensions"],
      "properties": {
        "group_id": {
          "$ref": "#/$defs/localId"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "extensions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/extension"
          }
        }
      }
    },
    "extensionTotal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extension",
        "direct_file_count",
        "direct_logical_bytes",
        "recursive_file_count",
        "recursive_logical_bytes"
      ],
      "properties": {
        "extension": {
          "$ref": "#/$defs/extension"
        },
        "direct_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "direct_logical_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "recursive_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "recursive_logical_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason_code", "explanation"],
      "properties": {
        "state": {
          "enum": ["normal", "review_only", "protected", "unavailable"]
        },
        "reason_code": {
          "$ref": "#/$defs/localId"
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "folder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "folder_id",
        "parent_id",
        "path",
        "name",
        "depth",
        "direct_file_count",
        "recursive_file_count",
        "direct_logical_bytes",
        "recursive_logical_bytes",
        "direct_zero_byte_files",
        "recursive_zero_byte_files",
        "extension_totals",
        "access"
      ],
      "properties": {
        "folder_id": {
          "$ref": "#/$defs/localId"
        },
        "parent_id": {
          "oneOf": [
            {"$ref": "#/$defs/localId"},
            {"type": "null"}
          ]
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        },
        "direct_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "recursive_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "direct_logical_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "recursive_logical_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "direct_zero_byte_files": {
          "type": "integer",
          "minimum": 0
        },
        "recursive_zero_byte_files": {
          "type": "integer",
          "minimum": 0
        },
        "extension_totals": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/extensionTotal"
          }
        },
        "access": {
          "$ref": "#/$defs/access"
        }
      }
    },
    "fileDetailSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage",
        "retained_files",
        "omitted_files",
        "retained_logical_bytes",
        "omitted_logical_bytes"
      ],
      "properties": {
        "coverage": {
          "enum": ["complete", "bounded"]
        },
        "retained_files": {
          "type": "integer",
          "minimum": 0
        },
        "omitted_files": {
          "type": "integer",
          "minimum": 0
        },
        "retained_logical_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "omitted_logical_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "emptySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zero_byte_files", "collapsed_tree_count", "trees"],
      "properties": {
        "zero_byte_files": {
          "type": "integer",
          "minimum": 0
        },
        "collapsed_tree_count": {
          "type": "integer",
          "minimum": 0
        },
        "trees": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/emptyTree"
          }
        }
      }
    },
    "emptyTree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "highest_folder_id",
        "path",
        "descendant_zero_byte_files",
        "descendant_directories",
        "recoverable_bytes"
      ],
      "properties": {
        "highest_folder_id": {
          "$ref": "#/$defs/localId"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "descendant_zero_byte_files": {
          "type": "integer",
          "minimum": 0
        },
        "descendant_directories": {
          "type": "integer",
          "minimum": 0
        },
        "recoverable_bytes": {
          "const": 0
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_id",
        "folder_id",
        "path",
        "name",
        "extension",
        "size_bytes",
        "modified_at_utc",
        "selection_state",
        "protection_reason"
      ],
      "properties": {
        "file_id": {
          "$ref": "#/$defs/localId"
        },
        "folder_id": {
          "$ref": "#/$defs/localId"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "extension": {
          "$ref": "#/$defs/extension"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "modified_at_utc": {
          "oneOf": [
            {"$ref": "#/$defs/utcDateTime"},
            {"type": "null"}
          ]
        },
        "selection_state": {
          "enum": ["selectable", "review_only", "protected"]
        },
        "protection_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "inaccessiblePath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "error_type", "message"],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "error_type": {
          "enum": [
            "access_denied",
            "disappeared",
            "locked",
            "invalid_metadata",
            "reparse_point",
            "other"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "scanError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "scope", "path", "message", "recoverable"],
      "properties": {
        "code": {
          "$ref": "#/$defs/localId"
        },
        "scope": {
          "enum": ["drive", "directory", "file", "report"]
        },
        "path": {
          "oneOf": [
            {"$ref": "#/$defs/path"},
            {"type": "null"}
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "recoverable": {
          "type": "boolean"
        }
      }
    }
  }
}
